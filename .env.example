# Application
APP_NAME=latest-ai-development
APP_ENV=dev

# API server
API_HOST=0.0.0.0
PORT=8080

# Server URL 
CONTEXT=/

# Runtime and logging
DEBUG=false
LOG_LEVEL=INFO

# Secret backend
CLOUD_PROVIDER=AWS
AWS_REGION=us-east-1
AZURE_KEY_VAULT_URL=

# Model provider secret names
OPENAI_API_KEY_SECRET=
ANTHROPICAI_API_KEY_SECRET=
GEMINIAI_API_KEY_SECRET=
BEDROCK_AI_API_KEY_SECRET=
OLLAMA_BASE_URL=http://localhost:11434

# Optional LangSmith tracing (native LangSmith environment configuration).
LANGSMITH_PROJECT=langchain-python-template
