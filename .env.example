# Application
APP_NAME=latest-ai-development
APP_ENV=dev

# API server
API_HOST=0.0.0.0
PORT=8080
API_ROOT_PATH=

# Runtime and logging
DEBUG=false
LOG_LEVEL=INFO
CONTEXT=knowledge

# Secret backend
CLOUD_PROVIDER=AWS
AWS_REGION=us-east-1
AZURE_KEY_VAULT_URL=

# Model provider secret names
OPENAI_API_KEY_SECRET=
ANTHROPICAI_API_KEY_SECRET=
GEMINIAI_API_KEY_SECRET=
BEDROCK_AI_API_KEY_SECRET=
OLLAMA_BASE_URL=http://localhost:11434

# Snowflake account/user/warehouse/database/schema belong in config/connection.yml.
# These exact variable names are explicitly referenced by that YAML file.
# Connection 1 (Hospitals + Patients): populate exactly one PAT source.
SNOWFLAKE_HOSPITAL_CORE_PAT_TOKEN=
SNOWFLAKE_HOSPITAL_CORE_PAT_SECRET_NAME=

# Connection 2 (Doctors): populate exactly one PAT source.
SNOWFLAKE_HOSPITAL_STAFF_PAT_TOKEN=
SNOWFLAKE_HOSPITAL_STAFF_PAT_SECRET_NAME=

# Optional LangSmith tracing (native LangSmith environment configuration).
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=langchain-python-template
LANGSMITH_API_KEY=
